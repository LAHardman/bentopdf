{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "local"
  },
  "build": {
    "ios-testflight": {
      "ios": {
        "config": "ios-release.yml"
      },
      "env": {
        "DISTRIBUTION": "testflight"
      }
    },
    "ios-adhoc": {
      "ios": {
        "config": "ios-release.yml"
      },
      "env": {
        "DISTRIBUTION": "adhoc"
      }
    }
  }
}
